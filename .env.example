# Copy to .env and fill in values
POSTGRES_USER=mvpclub
POSTGRES_PASSWORD=mvpclub_secret
POSTGRES_DB=mvpclub
JWT_SECRET=change_this_to_a_long_random_string
FRONTEND_URL=http://localhost:3001

# Email — any SMTP provider works. Leave SMTP_HOST blank to use a bare Gmail
# account (legacy). Set SMTP_HOST to point at a real provider, e.g. Brevo:
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_USER=<your Brevo SMTP login>
#   SMTP_PASS=<your Brevo SMTP key>
SMTP_USER=
SMTP_PASS=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=

# What outgoing app emails show as sender — once hello@mvpclub.io exists, set
# MAIL_FROM to it. Defaults to SMTP_USER if left blank.
MAIL_FROM=
MAIL_FROM_NAME=MVP Club
