# Copy to .env.production on the server and fill in. NEVER commit the real file.
# Generate secrets with:  openssl rand -hex 32

DOMAIN=mvpclub.io

POSTGRES_USER=mvpclub
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_32
POSTGRES_DB=mvpclub

JWT_SECRET=CHANGE_ME_openssl_rand_hex_32

# Email — app-sent mail (interview invites, digests, password reset). See the
# "Email" section in DEPLOY.md for full setup. Recommended: Brevo's free SMTP
# relay (300 emails/day, free forever), sending as hello@mvpclub.io.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME_brevo_smtp_login
SMTP_PASS=CHANGE_ME_brevo_smtp_key
MAIL_FROM=hello@mvpclub.io
MAIL_FROM_NAME=MVP Club
MAIL_REPLY_TO=shyam@shrishtisolutions.co.uk

# Optional integrations — leave empty to disable
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Optional — only powers the Idea stage's "Sage Market Snapshot" feature.
# Leave blank to keep every feature on the free local Ollama model (default).
# Set a real key (from console.anthropic.com) to switch specific features to
# Claude instead — currently Market Snapshot (with live web search, so
# TAM/SAM and competitors come from real current data) and idea-answer
# reactions. Billed per use — see Anthropic's pricing before enabling on a
# busy production instance. Two model tiers, same key: ANTHROPIC_MODEL is
# the flagship tier (Market Snapshot); ANTHROPIC_MODEL_CHEAP is the
# small/fast tier for high-frequency, low-stakes calls (idea reactions).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MODEL_CHEAP=claude-haiku-4-5
