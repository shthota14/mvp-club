# Copy to .env.production on the server and fill in. NEVER commit the real file.
# Generate secrets with:  openssl rand -hex 32

DOMAIN=mvpclub.io

POSTGRES_USER=mvpclub
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_32
POSTGRES_DB=mvpclub

JWT_SECRET=CHANGE_ME_openssl_rand_hex_32

# Email — app-sent mail (interview invites, digests, password reset). See the
# "Email" section in DEPLOY.md for full setup. Recommended: Brevo's free SMTP
# relay (300 emails/day, free forever), sending as hello@mvpclub.io.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME_brevo_smtp_login
SMTP_PASS=CHANGE_ME_brevo_smtp_key
MAIL_FROM=hello@mvpclub.io
MAIL_FROM_NAME=MVP Club

# Optional integrations — leave empty to disable
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
